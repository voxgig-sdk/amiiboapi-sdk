# Entity: type

main: kit: entity: type: {

  alias: field: {}

  fields: [
    {
      name: "key"
      req: false
      short: "Unique key for the amiibo type"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the amiibo type"
      type: "`$STRING`"
    }
  ]

  name: "type"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/type"
          segments: [
            {
              lit: "type"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.amiibo`"
          }
        }
      ]
    }
  }



}
